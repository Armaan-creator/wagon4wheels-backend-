.gradle/
build/
# Local-only overrides (Atlas connection string with real credentials) -
# Spring Boot auto-loads this file from the working directory, never commit it.
# Leading slash anchors this to the project root ONLY - without it, this
# rule also matched src/main/java/.../backend/config/ (the Java package)
# and silently excluded SecurityConfig.java from every commit.
/config/
!gradle/wrapper/gradle-wrapper.jar
uploads/
.idea/
*.iml
out/
.DS_Store
